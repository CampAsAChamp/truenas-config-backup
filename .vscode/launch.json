{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run app",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8080",
        "--reload",
        "--reload-dir",
        "app/src/app",
        "--reload-include",
        "*.py",
        "--reload-include",
        "*.html",
        "--reload-include",
        "*.css",
        "--reload-include",
        "*.js"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.local",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/app/src",
        "DEV_MODE": "true",
        "BACKUP_DIR": "${workspaceFolder}/local-data/backups",
        "CONFIG_DIR": "${workspaceFolder}/local-data/config",
        "TRUENAS_VERIFY_SSL": "false"
      },
      "preLaunchTask": "Prepare local data",
      "justMyCode": true
    },
    {
      "name": "Debug app (no reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8080"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.local",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/app/src",
        "BACKUP_DIR": "${workspaceFolder}/local-data/backups",
        "CONFIG_DIR": "${workspaceFolder}/local-data/config",
        "TRUENAS_VERIFY_SSL": "false"
      },
      "preLaunchTask": "Prepare local data",
      "justMyCode": true
    },
    {
      "name": "Capture dashboard screenshot",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/capture-dashboard-screenshot.py",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Install Playwright Chromium",
      "justMyCode": true
    },
    {
      "name": "Debug all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "--cov"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/app/src"
      },
      "justMyCode": true
    },
    {
      "name": "Debug current test file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${relativeFile}",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/app/src"
      },
      "justMyCode": true
    }
  ]
}
