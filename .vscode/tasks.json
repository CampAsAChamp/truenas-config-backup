{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare local data",
      "type": "shell",
      "command": "mkdir -p local-data/backups local-data/config && ${workspaceFolder}/.venv/bin/python scripts/seed-local-data.py --if-empty",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Dev server (hot reload)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/dev.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pip install -r requirements.txt -r requirements-dev.txt",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m pytest --cov",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run tests (current file)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m pytest ${relativeFile} -v",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Render catalog compose",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python .github/scripts/ci.py --app truenas-config-backup --train community --test-file basic-values.yaml --render-only=true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Seed local data (force)",
      "type": "shell",
      "command": "mkdir -p local-data/backups local-data/config && ${workspaceFolder}/.venv/bin/python scripts/seed-local-data.py --force",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build container (local tag)",
      "type": "shell",
      "command": "podman build -t ghcr.io/campasachamp/truenas-config-backup:local .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run container (local tag)",
      "type": "shell",
      "command": "podman run --rm -p 8080:8080 --env-file .env.local -e TRUENAS_VERIFY_SSL=false -v ${workspaceFolder}/local-data/backups:/backups -v ${workspaceFolder}/local-data/config:/config ghcr.io/campasachamp/truenas-config-backup:local",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Prepare local data",
        "Build container (local tag)"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run container (GHCR 0.1.0)",
      "type": "shell",
      "command": "podman run --rm -p 8080:8080 --env-file .env.local -e TRUENAS_VERIFY_SSL=false -v ${workspaceFolder}/local-data/backups:/backups -v ${workspaceFolder}/local-data/config:/config ghcr.io/campasachamp/truenas-config-backup:0.1.0",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Prepare local data dirs"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
