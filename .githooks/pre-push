#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

PYTHON="${ROOT}/.venv/bin/python"
RUFF="${ROOT}/.venv/bin/ruff"

if [[ ! -x "$PYTHON" || ! -x "$RUFF" ]]; then
  echo "pre-push: project venv not found at ${ROOT}/.venv" >&2
  echo "Create it and install dev deps:" >&2
  echo "  python3 -m venv .venv && .venv/bin/pip install -r requirements.txt -r requirements-dev.txt" >&2
  exit 1
fi

if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  GREEN=$'\033[1;32m'
  RED=$'\033[1;31m'
  RESET=$'\033[0m'
else
  GREEN=''
  RED=''
  RESET=''
fi

run_step() {
  local label="$1"
  shift
  local output
  printf 'pre-push: %s ... ' "$label" >&2
  if output=$("$@" 2>&1); then
    printf '%bpassed%b\n' "$GREEN" "$RESET" >&2
  else
    printf '%bfailed%b\n' "$RED" "$RESET" >&2
    printf '%s\n' "$output" >&2
    exit 1
  fi
}

run_step "ruff check app" "$RUFF" check app
run_step "pytest" "$PYTHON" -m pytest --cov --tb=short -q

printf 'pre-push: %ball checks passed%b\n' "$GREEN" "$RESET" >&2
