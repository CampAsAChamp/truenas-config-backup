# Copy to .env.local and fill in your TrueNAS details for local runs.
# Used by Run and Debug launch configs and container tasks.

TRUENAS_URL=https://192.168.1.50
TRUENAS_API_KEY=your-api-key-here
TRUENAS_VERIFY_SSL=false

# Optional
DASHBOARD_PASSWORD=your-dashboard-password
# CRON_SCHEDULE=0 3 * * 0
# NOTIFY_WEBHOOK_URL=
# NOTIFY_ON_SUCCESS=false
# HEALTH_CHECK_TRUENAS=false
